# Argo CD. The UI/API is plain HTTP on argo-argocd-server:80 behind the shared Envoy
# Gateway (argo.<base_domain>, TLS terminated there). The initial admin password is
# generated by the chart:
#   kubectl -n argo get secret argocd-initial-admin-secret -o jsonpath='{.data.password}' | base64 -d
# Argo reaches Gitea in-cluster over http (gitea-http.gitea.svc:3000); add
# repositories and Applications once there is something in Gitea to deploy.
resource "helm_release" "argo" {
  name             = "argo"
  repository       = "https://argoproj.github.io/argo-helm"
  chart            = "argo-cd"
  namespace        = "argo"
  create_namespace = true

  values = [yamlencode({
    "redis-ha" = { enabled = false }
    global     = { domain = "argo.${var.base_domain}" }
    configs = {
      params = {
        # TLS terminates at the Envoy Gateway, so argo-server speaks plain HTTP.
        "server.insecure" = true
      }
    }
    server = {
      # Ingress disabled; routed via the shared Envoy Gateway (see envoy-gateway.tf).
      ingress = { enabled = false }
    }
  })]
}
