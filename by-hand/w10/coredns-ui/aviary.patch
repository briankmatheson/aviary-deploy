+const HistoryCM = "coredns-ui-history"
+
+// Which CoreDNS this console looks after. The defaults are the cluster's
+// resolver; DNS_NAMESPACE, DNS_DEPLOYMENT, DNS_CONFIGMAP, DNS_SELECTOR and
+// DNS_SERVICE point it at another CoreDNS (aviary: the authoritative one).
+var (
+	DNSNamespace  = envOr("DNS_NAMESPACE", "kube-system")
+	DNSDeployment = envOr("DNS_DEPLOYMENT", "coredns")
+	DNSConfigMap  = envOr("DNS_CONFIGMAP", "coredns")
+	DNSSelector   = envOr("DNS_SELECTOR", "k8s-app=kube-dns")
+	DNSService    = envOr("DNS_SERVICE", "kube-dns")
 )
 
+func envOr(k, def string) string {
+	if v := os.Getenv(k); v != "" {
+		return v
+	}
+	return def
+}
