# aviary-deploy — copy to terraform.tfvars (gitignored) and fill in.
# Every stack (apps/, system/) reads this same file through a symlink.
#
# Required (no default): kubeconfig, cluster_name, ssh_load_balancer_ip, and the
# passwords / velero credentials below. Everything else is shown commented at
# its default — uncomment to override.
#
# Every secret here is the placeholder CHANGE_ME. Replace each before applying;
# they need not match (they're identical here only to keep the template scannable).

# ================================ Globals ================================

kubeconfig           = "/home/you/.kube/config"
cluster_name         = "my-cluster"    # capi cluster name

# Apps are served at <app>.<base_domain>, the landing page at <base_domain>.
# Point a wildcard DNS record (or /etc/hosts) at the Gateway's LoadBalancer IP.
base_domain          = "aviary.local"

# StorageClass for every PVC (gitea, grafana, rustpad, cnpg databases).
global_storage_class = "standard"

# cert-manager ClusterIssuer the shared Gateway uses for its TLS certificates.
#   internal-acme : the shared step-ca on the management cluster. One root to
#                   trust, and it survives workload-cluster rebuilds.
#   ca-issuer     : a per-cluster self-signed root, regenerated on every
#                   rebuild — so every client has to re-trust it each time.
cluster_issuer       = "internal-acme"

# Prefix applied to every app namespace this project creates (RFC 1123:
# lowercase, no underscores). "" disables it.
# ns_prefix          = "aviary-"

# Shared Envoy Gateway the apps' HTTPRoutes attach to.
# gateway_name       = "noname"
# gateway_namespace  = "envoy-gateway"

# ================================= Gitea =================================

gitea_admin_password = "CHANGE_ME"
# Gitea ssh Service LoadBalancer IP, from your LB pool (Cilium LB IPAM / MetalLB).
ssh_load_balancer_ip = "192.168.133.9"
# Second Gateway (aviary-nat) on its own LB address, for NATing in from outside.
# nat_gateway_ip = "192.168.133.10"
# Apps are only served there once switched to public on the landing page.
# Hostnames on that second Gateway: <app>.<public_domain> instead of
# <app>.<base_domain>, with Let's Encrypt certificates (needs public DNS and
# ports 80/443 NATed to nat_gateway_ip) unless public_cluster_issuer names
# another ClusterIssuer.
# public_domain         = "example.org"
# public_cluster_issuer = ""
# ssh_external_host  = ""                 # default ssh.gitea.<base_domain>
# postgresql_enabled = true               # the chart's bundled single-node Postgres

# ================================= Drone =================================
# After the first apply, create the Gitea OAuth2 app (redirect
# https://drone.<base_domain>/login), then set id/secret below and re-apply.

drone_rpc_secret            = "CHANGE_ME"
# drone_admin_user          = "bmath"     # gitea login made Drone admin
# drone_gitea_client_id     = ""
# drone_gitea_client_secret = "CHANGE_ME"

# ================================ Grafana ================================

grafana_admin_password = "CHANGE_ME"
# grafana_namespace    = "grafana"

# ============================== CloudBeaver ==============================

cloudbeaver_admin_password = "CHANGE_ME"
# cloudbeaver_chart_path   = "./charts/cloudbeaver-deploy/k8s"

# ========================= Postgres (CloudNativePG) ======================

# cnpg_namespace = "cnpg-system"          # the CloudNativePG operator's namespace

# ================================ Harbor =================================

# harbor_namespace    = "harbor"
# harbor_external_url = ""                 # default https://harbor.<base_domain>
# harbor_ipv6_enabled = false

# ================================ Rustpad ================================

# rustpad_namespace = "rustpad"
# rustpad_pvc_size  = 4

# ============================= Aviary frontend ===========================

# aviary_frontend_image = "briankmatheson/aviary-frontend:1.0.2"

# ================================= SigNoz ================================

# signoz_namespace = "signoz"

# ================================= Velero ================================

velero_credentials_secret = <<-CREDS
  [default]
  aws_access_key_id = CHANGE_ME
  aws_secret_access_key = CHANGE_ME
CREDS
# velero_backup_storage_name     = "backups"
# velero_backup_storage_provider = "aws"
# velero_backup_storage_bucket   = "velero-backups"
# velero_backup_storage_region   = "us-east-1"

# --- Axigen mail server (AxiHelm) --- off until the license path is set
# axigen_license_file   = "/path/to/axigen_lk.bin"
# axigen_cluster_key    = ""
# axigen_admin_password = ""
# axigen_mail_domain    = ""            # default: base_domain
# axigen_timezone       = "America/New_York"
# axigen_storage_size   = "10Gi"


# Chat window on the landing page, served by Ollama on the GPU node
# (needs a node labelled nvidia.com/gpu.present and the NVIDIA device plugin).
# ollama_enabled    = true
# aviary_chat_model = "llama3"
